/**
 * NawaAsk Cloud Worker — non-secret configuration.
 *
 * Provisioning (only when the feature ships):
 *   wrangler d1 create nawaask-db          # then paste database_id below
 *   wrangler kv namespace create CACHE
 *   wrangler r2 bucket create nawaask-files
 *
 * Secrets (never commit):
 *   wrangler secret put <NAME>
 * Local dev secrets: backend/.dev.vars (gitignored, see .dev.vars.example)
 */
{
  "name": "nawaask-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "vars": {
    "APP_ENV": "development",
    "API_VERSION": "v1",
    "ALLOWED_ORIGINS": "kdcjedhlpbfojibibmhbjhaklgomafbb",
  },
  // "d1_databases": [
  //   { "binding": "DB", "database_name": "nawaask-db", "database_id": "<paste-after-create>" }
  // ],
  // "kv_namespaces": [
  //   { "binding": "CACHE", "id": "<paste-after-create>" }
  // ],
  // "r2_buckets": [
  //   { "binding": "FILES", "bucket_name": "nawaask-files" }
  // ]
}
