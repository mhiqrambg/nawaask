# Public, non-secret extension configuration.
# Copy to .env for local builds (both files are gitignored patterns; never commit secrets here).
# There are no secrets in this file — the cloud base URL is public configuration.

# Optional NawaAsk Cloud backend base URL (no trailing slash).
# Leave empty (default) = Cloud mode unavailable, BYOK works fully.
# Example after deploying the Worker:
# VITE_NAWAASK_CLOUD_API_BASE_URL=https://nawaask-api.<subdomain>.workers.dev
VITE_NAWAASK_CLOUD_API_BASE_URL=
